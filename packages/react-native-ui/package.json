{
  "name": "@agent-ui-sdk/react-native-ui",
  "version": "0.1.0",
  "description": "Styled UI components for Agent UI SDK — React Native",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-ui-sdk/core": "workspace:*",
    "@agent-ui-sdk/react-native": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react-native": ">=0.300.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.72.0"
  },
  "peerDependenciesMeta": {
    "lucide-react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agent-ui-sdk/build-utils": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.73.0",
    "lucide-react-native": "^0.475.0",
    "react": "^19.0.0",
    "react-native": "^0.76.0",
    "react-native-svg": "^15.0.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
