{
  "name": "@agent-ui-sdk/react",
  "version": "0.1.0",
  "description": "React web components for Agent UI SDK — styled, ready-to-use AI chat UI",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-ui-sdk/core": "workspace:*",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@streamdown/cjk": "^1.0.2",
    "@streamdown/code": "^1.0.3",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.35.0",
    "nanoid": "^5.1.6",
    "radix-ui": "^1.4.3",
    "shadcn": "^3.8.5",
    "shiki": "^4.0.1",
    "streamdown": "^2.3.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.3"
  },
  "peerDependencies": {
    "@ai-sdk/react": ">=3.0.0",
    "@tiptap/core": ">=3.20.0",
    "@tiptap/extension-mention": ">=3.20.0",
    "@tiptap/extension-placeholder": ">=3.20.0",
    "@tiptap/pm": ">=3.20.0",
    "@tiptap/react": ">=3.20.0",
    "@tiptap/starter-kit": ">=3.20.0",
    "@tiptap/suggestion": ">=3.20.0",
    "ai": ">=6.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": { "optional": true },
    "@tiptap/extension-mention": { "optional": true },
    "@tiptap/extension-placeholder": { "optional": true },
    "@tiptap/pm": { "optional": true },
    "@tiptap/react": { "optional": true },
    "@tiptap/starter-kit": { "optional": true },
    "@tiptap/suggestion": { "optional": true }
  },
  "devDependencies": {
    "@ai-sdk/react": "^3.0.113",
    "@tiptap/core": "^3.20.1",
    "@tiptap/extension-mention": "^3.20.1",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@tiptap/suggestion": "^3.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ai": "^6.0.111",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT"
}
