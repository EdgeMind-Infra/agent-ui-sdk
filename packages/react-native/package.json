{
  "name": "@agent-ui-sdk/react-native",
  "version": "0.1.0",
  "description": "React Native primitives for Agent UI SDK",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-ui-sdk/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": "*"
  },
  "devDependencies": {
    "@agent-ui-sdk/build-utils": "workspace:*",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-native": "^0.78.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT"
}
